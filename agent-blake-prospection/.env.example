# Copie ce fichier en ".env" pour le développement local et remplis les valeurs.
# Le fichier ".env" ne doit JAMAIS être commité.
# En déploiement (Cloud Function), ces variables sont injectées via
# --set-env-vars / --set-secrets au moment du gcloud functions deploy —
# jamais via ce fichier.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
