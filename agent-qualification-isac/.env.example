# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PAPPERS_API_KEY=

# JSON complet des identifiants du compte de service Google (pas un chemin
# de fichier : la valeur brute, sur une seule ligne), avec accès au sheet
# ci-dessous partagé en Éditeur.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# URL d'un Incoming Webhook Slack (Slack > gérer les apps > Incoming Webhooks)
SLACK_WEBHOOK_URL=
